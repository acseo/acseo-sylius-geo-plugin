{
    "name": "acseo/sylius-geo-plugin",
    "type": "sylius-plugin",
    "description": "Sylius plugin for Generative Engine Optimization (llm.txt + Markdown for AI crawlers).",
    "keywords": [
        "ai-crawlers",
        "geo",
        "llm-txt",
        "markdown",
        "sylius",
        "sylius-plugin"
    ],
    "license": "MIT",
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "ext-xmlwriter": "*",
        "sylius/sylius": "~2.0.0 || ~2.1.0 || ~2.2.0 || ~2.3.0",
        "symfony/framework-bundle": "^6.4 || ^7.4"
    },
    "require-dev": {
        "api-platform/doctrine-common": "^4.0.3",
        "api-platform/documentation": "^4.0.3",
        "api-platform/http-cache": "^4.0.3",
        "api-platform/hydra": "^4.0.3",
        "api-platform/json-schema": "^4.0.3",
        "api-platform/jsonld": "^4.0.3",
        "api-platform/metadata": "^4.0.3",
        "api-platform/openapi": "^4.0.3",
        "api-platform/ramsey-uuid": "^4.0",
        "api-platform/serializer": "^4.0.3",
        "api-platform/state": "^4.0.3",
        "api-platform/validator": "^4.0.3",
        "behat/behat": "^3.17",
        "ekino/phpstan-banned-code": "^3.2",
        "friends-of-behat/mink": "^1.11",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/variadic-extension": "^1.6",
        "nyholm/psr7": "^1.8",
        "payum/core": "^1.7.7",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius-labs/suite-tags-extension": "~0.2",
        "sylius/test-application": "~2.0.0@alpha >=2.0.0-alpha.7 || ~2.1.0@alpha || ~2.2.0@alpha || ~2.3.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/intl": "^6.4 || ^7.4",
        "symfony/runtime": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4",
        "symfony/webpack-encore-bundle": "^2.2",
        "symplify/easy-coding-standard": "^13.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "require": "^6.4 || ^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "ACSEO\\SyliusGeoPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\ACSEO\\SyliusGeoPlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migration:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    },
    "homepage": "https://www.acseo.fr/",
    "authors": [
        {
            "name": "ACSEO",
            "homepage": "https://www.acseo.fr/"
        }
    ]
}
